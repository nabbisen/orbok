# Maintainer: nabbisen <19984221+nabbisen@users.noreply.github.com>
#
# Arch Linux PKGBUILD for orbok: local-first AI document search.
#
# Template only -- this file is never run directly with `makepkg -si` to
# publish. `packaging/linux/aur-prepare.sh <version> <work-dir>`, in the
# orbok repository, writes the real, hash-verified copy that actually goes
# to the AUR.
#
# Builds from orbok's released source archive, not GitHub's automatic
# per-tag archive: that archive has no top-level directory, so `prepare()`
# extracts it into one of its own.

pkgname=orbok
# Matches [workspace.package] version in Cargo.toml at the tagged commit.
pkgver=0.28.0
pkgrel=1
pkgdesc="Local-first AI document search -- private and storage-aware"
arch=('x86_64')
url="https://github.com/nabbisen/orbok"
license=('Apache-2.0')
# makepkg's C-level LTO (the default `lto` option) breaks the link of the
# bundled SQLite/zstd objects against rust-lld; Rust's own LTO is kept.
options=('!lto')
# Windowing, input and the Vulkan loader -- measured from the libraries the
# binary actually loads, on both Wayland and X11. The GPU driver itself
# (mesa, nvidia-utils, or another vendor's) is not listed: it is already a
# system requirement for any accelerated application, not specific to
# orbok, and pinning one vendor here would be wrong on different hardware.
depends=(
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
    'libx11'
    'libxcursor'
    'libxi'
    'vulkan-icd-loader'
    # The hicolor theme hierarchy this package installs its icons into
    # (package()'s loop below) -- a data/trigger dependency LD_DEBUG
    # cannot see, found by namcap (Task 130).
    'hicolor-icon-theme'
)
# Without xdg-desktop-portal, the native folder picker has nothing to talk
# to; typing the path into the Folders page's own field still works.
# Without a CJK-capable font, Japanese text renders as gaps, not tofu
# boxes, and does not crash orbok.
optdepends=(
    'xdg-desktop-portal: a native folder picker for Add folder'
    'noto-fonts-cjk: Japanese text (otherwise it renders as gaps, not boxes)'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/nabbisen/orbok/releases/download/$pkgver/$pkgname-$pkgver.tar.gz")
noextract=("$pkgname-$pkgver.tar.gz")
# Permanent, not a gap to close before publishing -- aur-prepare.sh
# computes the real hash from the released archive's own .sha256 and
# writes it only into the copy it produces for the AUR.
sha256sums=('SKIP')

prepare() {
    mkdir -p "$pkgname-$pkgver"
    # The archive's own entries start with "./" at its root -- there is no
    # "$pkgname-$pkgver/" top-level directory to `cd` into, so this
    # extracts into one built here instead.
    tar -xzf "$pkgname-$pkgver.tar.gz" -C "$pkgname-$pkgver"
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # The default build already includes search by meaning -- no extra
    # --features flag needed.
    cargo build --frozen --release -p orbok
}

check() {
    cd "$pkgname-$pkgver"
    # Headless and fast: proves the built binary opens a fresh catalog and
    # runs its own startup migrations, without a display.
    ORBOK_DATA_DIR="$srcdir/check-data" target/release/orbok --check
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/orbok "$pkgdir/usr/bin/orbok"
    install -Dm644 packaging/linux/orbok.desktop \
        "$pkgdir/usr/share/applications/orbok.desktop"
    # Every size this repository carries, so Icon=orbok (above) always
    # resolves.
    for size in 16 32 48 64 128 256 512; do
        install -Dm644 "packaging/linux/icons/hicolor/${size}x${size}/apps/orbok.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/orbok.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
